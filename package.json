{
  "name": "magpie-compatible-fix",
  "version": "0.2.2",
  "description": "Magpie gateway middleware compatibility fixes for MultiAgentV2 agent_message, sealed ChatGPT subagent tasks, Open Design Haiku 5.5 thinking, output limits, sampling, and DeepSeek DSML tools",
  "type": "module",
  "files": [
    "compatible-fix.middleware.js",
    "README.md",
    "VALIDATION.md",
    "OPENDESIGN-THINKING-BLOCKER.md",
    "LICENSE"
  ],
  "license": "MIT",
  "keywords": [
    "magpie",
    "magpie-plugin",
    "middleware",
    "claude",
    "haiku",
    "thinking",
    "agent_message"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HachinRo/magpie-compatible-fix.git"
  },
  "magpie": {
    "middleware": "./compatible-fix.middleware.js",
    "options": {
      "mode": "adaptive",
      "defaultEffort": "medium",
      "removeSampling": true,
      "maxOutputTokens": 128000,
      "maxOutputTokensByModel": {},
      "sealedTaskModel": "codex/gpt-6.1-sol",
      "maxToolBytes": 30000
    }
  },
  "scripts": {
    "check": "node --check compatible-fix.middleware.js",
    "test": "node --test test/*.test.mjs",
    "test:gateway": "node scripts/test-gateway.mjs",
    "test:regression": "node scripts/regression/harness.mjs",
    "test:thinking:live": "node scripts/test-thinking-live.mjs --live"
  },
  "engines": {
    "node": ">=20"
  }
}
