{
  "name": "magpie-compatible-fix",
  "version": "0.2.7",
  "description": "Magpie compatibility fixes preserving verified Open Design DeepSeek vision, compaction, namespaced tool responses, oversized text request bodies, thinking tool_choice, MultiAgentV2 agent_message, sealed ChatGPT tasks, Haiku thinking, output limits, sampling, and DeepSeek DSML tools",
  "type": "module",
  "main": "./compact-transport.mjs",
  "files": [
    "compatible-fix.middleware.js",
    "compact-transport.mjs",
    "README.md",
    "VALIDATION.md",
    "OPENDESIGN-THINKING-BLOCKER.md",
    "LICENSE"
  ],
  "license": "MIT",
  "keywords": [
    "magpie",
    "magpie-plugin",
    "middleware",
    "claude",
    "haiku",
    "thinking",
    "agent_message"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HachinRo/magpie-compatible-fix.git"
  },
  "magpie": {
    "middleware": "./compatible-fix.middleware.js",
    "options": {
      "mode": "adaptive",
      "defaultEffort": "medium",
      "removeSampling": true,
      "maxOutputTokens": 128000,
      "maxOutputTokensByModel": {},
      "sealedTaskModel": "codex/gpt-6.1-sol",
      "maxToolBytes": 30000,
      "maxRequestBytes": 20971520,
      "stripDataImages": false,
      "rejectInlineDataImages": false
    }
  },
  "scripts": {
    "check": "node --check compatible-fix.middleware.js && node --check compact-transport.mjs",
    "test": "node --test test/*.test.mjs",
    "test:gateway": "node scripts/test-gateway.mjs",
    "test:namespace:gateway": "node scripts/test-namespace-gateway.mjs",
    "test:regression": "node scripts/regression/harness.mjs",
    "test:thinking:live": "node scripts/test-thinking-live.mjs --live"
  },
  "engines": {
    "node": ">=20"
  }
}
